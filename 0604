#define ledPin 13  // LED는 디지털 핀 13에 연결됨

int linesensor_data[5] = {0, 0, 0, 0, 0};     // 센서 값 저장용 배열
int linesensor_pin[5] = {2, 3, 4, 5, 6};      // 센서가 연결된 디지털 핀 번호

void setup() {
  Serial.begin(9600);          // 시리얼 통신 시작
  pinMode(ledPin, OUTPUT);     // LED 핀을 출력으로 설정

  // 센서 핀들을 입력으로 설정
  for (int i = 0; i < 5; i++) {
    pinMode(linesensor_pin[i], INPUT);
  }
}

void loop() {
  // 센서 값 읽기
  for (int i = 0; i < 5; i++) {
    linesensor_data[i] = digitalRead(linesensor_pin[i]);
  }

  // 센서 값 출력
  Serial.print("Input data = ");
  for (int i = 0; i < 5; i++) {
    Serial.print(linesensor_data[i]);
    Serial.print(" ");
  }
  Serial.println();  // 줄바꿈

  delay(200);  // 200ms 대기 (너무 빠른 출력 방지)
}
